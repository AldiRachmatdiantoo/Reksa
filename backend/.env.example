# Untuk menjalankan backend langsung di host (npm run dev) sambil memakai
# Postgres & Redis dari docker compose + docker-compose.dev.yml.
# Salin ke backend/.env. Jangan pernah commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Pakai password yang sama dengan APP_DB_PASSWORD / REDIS_PASSWORD di .env root.
DATABASE_URL=postgresql://app_service_user:CHANGE_ME@127.0.0.1:5432/reksa
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

CORS_ORIGIN=http://localhost:5173

# Buat dengan: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG________
JWT_REFRESH_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG________

AI_PROVIDER_MODE=mock
MOCK_AI_LATENCY_MS=300
GEMINI_API_KEY=

// REKSA database schema (PRD §7).
//
// Hal yang TIDAK bisa diekspresikan di file ini dan ada di migrasi SQL manual
// (prisma/migrations/*_security_hardening/migration.sql):
//   - CHECK constraints (skor 0..100, interval_day IN (3, 7))
//   - Partial indexes (idx_spaced_user_due, idx_sessions_class_governance)
//   - Role app_service_user, GRANT/REVOKE, dan kebijakan RLS
//
// PENTING saat membuat migrasi baru dengan `prisma migrate dev --create-only`:
// Prisma tidak mengenal partial index di atas dan bisa menambahkan
// `DROP INDEX` untuknya. Hapus baris itu dari migrasi sebelum di-apply.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  EDUCATOR
  INSTITUTION_ADMIN
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum Tier {
  FREE
  PRO
}

enum SessionType {
  INITIAL_BLURTING
  SPACED_REVIEW
}

/// FR-02: sesi dengan fokus aktual < 50% durasi preset ditandai SHORT_FOCUS.
enum SessionValidity {
  VALID
  SHORT_FOCUS
}

/// FR-05: status audit AI asinkron.
enum AuditStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum SessionStatus {
  FOCUS_ACTIVE
  AWAITING_JOL
  AWAITING_SCAN
  COMPLETED
  EXPIRED
}

model Institution {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users   User[]
  classes Class[]
  invites EducatorInvite[]

  @@map("institutions")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @db.VarChar(254)
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name") @db.VarChar(100)
  role            Role      @default(STUDENT)
  tier            Tier      @default(FREE)
  institutionId   String?   @map("institution_id") @db.Uuid
  dailyScanCount  Int       @default(0) @map("daily_scan_count")
  lastScanResetAt DateTime? @map("last_scan_reset_at") @db.Timestamptz(6)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// FR-13: persetujuan dokumen dan tahun lahir. Null pada akun sebelum FR-13 (wajib setuju ulang).
  birthYear       Int?      @map("birth_year") @db.SmallInt
  termsVersion    String?   @map("terms_version") @db.VarChar(32)
  privacyVersion  String?   @map("privacy_version") @db.VarChar(32)
  consentedAt     DateTime? @map("consented_at") @db.Timestamptz(6)
  guardianConsent Boolean   @default(false) @map("guardian_consent")
  /// FR-11: tier efektif PRO selama tanggal ini belum lewat.
  proExpiresAt    DateTime? @map("pro_expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  institution      Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  refreshTokens    RefreshToken[]
  authTokens       AuthToken[]
  taughtClasses    Class[]             @relation("ClassEducator")
  classMemberships ClassMember[]
  materials        StudyMaterial[]
  studySessions    StudySession[]
  submissions      EssaySubmission[]
  spacedSchedules  SpacedSchedule[]
  dataExports      DataExport[]
  proRedemptions   ProCodeRedemption[]
  createdInvites   EducatorInvite[]

  @@unique([email], map: "idx_users_email")
  @@index([institutionId], map: "idx_users_institution")
  @@map("users")
}

/// Token email sekali pakai (FR-14). Hanya SHA-256-nya yang disimpan.
model AuthToken {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @map("token_hash") @db.VarChar(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Alamat tujuan, hanya untuk EMAIL_CHANGE (CHECK di migrasi email_change_target).
  newEmail  String?          @map("new_email") @db.VarChar(254)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "idx_auth_tokens_hash")
  @@map("auth_tokens")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(128)
  familyId  String    @map("family_id") @db.Uuid
  isRevoked Boolean   @default(false) @map("is_revoked")
  /// Diisi hanya saat rotasi normal; dipakai untuk membedakan balapan antartab dari token curian.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "idx_refresh_tokens_hash")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([userId], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

model Class {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId String?  @map("institution_id") @db.Uuid
  educatorId    String   @map("educator_id") @db.Uuid
  classCode     String   @map("class_code") @db.VarChar(16)
  name          String   @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  institution Institution?    @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  educator    User            @relation("ClassEducator", fields: [educatorId], references: [id], onDelete: Restrict)
  members     ClassMember[]
  materials   StudyMaterial[]
  sessions    StudySession[]

  @@unique([classCode], map: "idx_classes_code")
  @@index([educatorId], map: "idx_classes_educator")
  @@index([institutionId], map: "idx_classes_institution")
  @@map("classes")
}

model ClassMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId], map: "idx_class_members_class_student")
  @@index([studentId], map: "idx_class_members_student")
  @@map("class_members")
}

model StudyMaterial {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploaderId          String   @map("uploader_id") @db.Uuid
  classId             String?  @map("class_id") @db.Uuid
  title               String   @db.VarChar(200)
  contentHash         String   @map("content_hash") @db.VarChar(64)
  // Null untuk materi berupa teks mentah (tidak ada file di storage).
  storageKey          String?  @map("storage_key")
  extractedRubricJson Json?    @map("extracted_rubric_json")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader        User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  class           Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  sessions        StudySession[]   @relation("SessionMaterial")
  /// F3: sesi interleaving yang memakai materi ini sebagai materi kedua.
  secondSessions  StudySession[]   @relation("SessionSecondMaterial")
  spacedSchedules SpacedSchedule[]

  @@index([contentHash], map: "idx_materials_content_hash")
  @@index([uploaderId, createdAt(sort: Desc)], map: "idx_materials_uploader_created")
  @@map("study_materials")
}

model StudySession {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  materialId         String           @map("material_id") @db.Uuid
  classId            String?          @map("class_id") @db.Uuid
  sessionType        SessionType      @map("session_type")
  plannedDurationSec Int              @map("planned_duration_sec")
  actualDurationSec  Int?             @map("actual_duration_sec")
  // Disimpan saat PATCH /sessions/:id/jol, sebelum foto diunggah (FR-03).
  predictedJolScore  Int?             @map("predicted_jol_score")
  status             SessionStatus    @default(FOCUS_ACTIVE)
  // Diisi bersamaan saat fokus diakhiri (PATCH /sessions/:id/jol), lihat migrasi session_validity.
  validity           SessionValidity?
  focusEndedAt       DateTime?        @map("focus_ended_at") @db.Timestamptz(6)
  startedAt          DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz(6)
  // Sesi SPACED_REVIEW: jadwal H+3/H+7 yang sedang dilatih (migrasi spaced_review_session).
  spacedScheduleId   String?          @map("spaced_schedule_id") @db.Uuid
  // F3 interleaving: materi kedua yang dicampur dalam sesi ini (CHECK di migrasi interleaved_session).
  secondMaterialId   String?          @map("second_material_id") @db.Uuid

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  material       StudyMaterial    @relation("SessionMaterial", fields: [materialId], references: [id], onDelete: Restrict)
  secondMaterial StudyMaterial?   @relation("SessionSecondMaterial", fields: [secondMaterialId], references: [id], onDelete: Restrict)
  class          Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  spacedSchedule SpacedSchedule?  @relation(fields: [spacedScheduleId], references: [id], onDelete: SetNull)
  submission     EssaySubmission?

  @@index([userId, startedAt(sort: Desc)], map: "idx_sessions_user_started")
  @@index([spacedScheduleId], map: "idx_sessions_spaced_schedule")
  @@index([secondMaterialId], map: "idx_sessions_second_material")
  @@map("study_sessions")
}

model EssaySubmission {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId            String      @map("session_id") @db.Uuid
  userId               String      @map("user_id") @db.Uuid
  imageStorageKey      String      @map("image_storage_key")
  predictedJolScore    Int         @map("predicted_jol_score")
  // Kolom hasil terisi hanya saat DONE (migrasi essay_audit_async; trigger mengunci baris DONE).
  actualAiScore        Int?        @map("actual_ai_score")
  accurateConceptsJson Json?       @map("accurate_concepts_json")
  blindSpotsJson       Json?       @map("blind_spots_json")
  logicCorrectionsJson Json?       @map("logic_corrections_json")
  encouragingSummary   String?     @map("encouraging_summary")
  ledgerHash           String?     @map("ledger_hash") @db.VarChar(64)
  auditStatus          AuditStatus @default(PENDING) @map("audit_status")
  auditAttempts        Int         @default(0) @map("audit_attempts")
  auditErrorCode       String?     @map("audit_error_code") @db.VarChar(64)
  auditStartedAt       DateTime?   @map("audit_started_at") @db.Timestamptz(6)
  auditedAt            DateTime?   @map("audited_at") @db.Timestamptz(6)
  quotaChargedAt       DateTime?   @map("quota_charged_at") @db.Timestamptz(6)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  session         StudySession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  spacedSchedules SpacedSchedule[]

  @@unique([sessionId], map: "idx_submissions_session")
  @@index([userId, createdAt(sort: Desc)], map: "idx_submissions_user_created")
  // FR-07: GET /ledger/verify/:hash lewat fungsi ledger_lookup (migrasi ledger_verify).
  @@index([ledgerHash], map: "idx_submissions_ledger_hash")
  @@map("essay_submissions")
}

model SpacedSchedule {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  originSubmissionId   String   @map("origin_submission_id") @db.Uuid
  materialId           String   @map("material_id") @db.Uuid
  targetBlindSpotsJson Json     @map("target_blind_spots_json")
  intervalDay          Int      @map("interval_day")
  nextReviewAt         DateTime @map("next_review_at") @db.Timestamptz(6)
  isCompleted          Boolean  @default(false) @map("is_completed")

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  originSubmission EssaySubmission @relation(fields: [originSubmissionId], references: [id], onDelete: Cascade)
  material         StudyMaterial   @relation(fields: [materialId], references: [id], onDelete: Restrict)
  reviewSessions   StudySession[]

  // Satu jadwal H+3 dan satu H+7 per materi per submission (sesi interleaving punya dua materi).
  @@unique([originSubmissionId, materialId, intervalDay], map: "idx_spaced_origin_material_interval")
  @@map("spaced_schedules")
}

/// FR-13/FR-12: arsip data dan PDF ledger di storage privat, dihapus pembersih berkala setelah expiresAt.
model DataExport {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  kind       String   @db.VarChar(16)
  storageKey String   @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt(sort: Desc)], map: "idx_data_exports_user_kind_created")
  @@index([expiresAt], map: "idx_data_exports_expires")
  @@map("data_exports")
}

/// FR-11: kode aktivasi Pro. Hanya hash yang disimpan; dibuat lewat skrip admin.
model ProActivationCode {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeHash        String   @map("code_hash") @db.VarChar(64)
  label           String?  @db.VarChar(100)
  durationDays    Int      @map("duration_days")
  maxRedemptions  Int      @map("max_redemptions")
  redemptionCount Int      @default(0) @map("redemption_count")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  redemptions ProCodeRedemption[]

  @@unique([codeHash], map: "idx_pro_codes_hash")
  @@map("pro_activation_codes")
}

model ProCodeRedemption {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeId     String   @map("code_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  redeemedAt DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  code ProActivationCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([codeId, userId], map: "idx_pro_redemptions_code_user")
  @@index([userId], map: "idx_pro_redemptions_user")
  @@map("pro_code_redemptions")
}

/// FR-10: kode undangan pengajar dari admin institusi. Hanya SHA-256 kodenya yang disimpan.
model EducatorInvite {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institutionId String    @map("institution_id") @db.Uuid
  tokenHash     String    @map("token_hash") @db.VarChar(64)
  createdBy     String    @map("created_by") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  creator     User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "idx_educator_invites_token_hash")
  @@index([institutionId, createdAt(sort: Desc)], map: "idx_educator_invites_institution")
  @@map("educator_invites")
}

# Konfigurasi docker compose. Salin ke .env lalu ganti semua CHANGE_ME.
# Jangan pernah commit .env.
#
# Password masuk ke dalam URL koneksi, jadi pakai karakter URL-safe.
# Buat dengan: openssl rand -hex 32

# Pemilik skema database (dipakai untuk migrasi saja)
POSTGRES_OWNER_USER=reksa_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME

# Role aplikasi least-privilege (app_service_user)
APP_DB_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME

# Wajib berbeda satu sama lain, minimal 32 karakter
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# mock (Fase 1-2) | gemini (Fase 3)
AI_PROVIDER_MODE=mock
MOCK_AI_LATENCY_MS=300
GEMINI_API_KEY=

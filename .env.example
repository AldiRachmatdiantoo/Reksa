# Konfigurasi docker compose. Salin ke .env lalu ganti semua CHANGE_ME.
# Jangan pernah commit .env.
#
# Password masuk ke dalam URL koneksi, jadi pakai karakter URL-safe.
# Buat dengan: openssl rand -hex 32

# Pemilik skema database (dipakai untuk migrasi saja)
POSTGRES_OWNER_USER=reksa_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME

# Role aplikasi least-privilege (app_service_user)
APP_DB_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME

# Wajib berbeda satu sama lain, minimal 32 karakter
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# Object storage S3-compatible (lokal: SeaweedFS di compose; produksi: Supabase Storage).
# Kunci lokal bebas, cukup hex (openssl rand -hex 16 / -hex 32).
STORAGE_BUCKET=reksa-private
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
# Host yang dipakai browser untuk signed URL.
STORAGE_PUBLIC_ENDPOINT=http://localhost:8333

# Email: di compose dikirim ke Mailpit (kotak masuk http://localhost:8025).
# Produksi: SMTP penyedia email, mis. smtps://resend:<api-key>@smtp.resend.com:465
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM="REKSA <no-reply@reksa.local>"
APP_URL=http://localhost:8080

CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# mock (contoh tetap, tanpa API) | gemini (Gemini asli, butuh GEMINI_API_KEY)
AI_PROVIDER_MODE=mock
MOCK_AI_LATENCY_MS=300
# Kunci dari https://aistudio.google.com/apikey. Free tier: gratis, tapi Google boleh memakai data yang dikirim
# untuk mengembangkan produknya, dan kuota harian per model kecil. Lihat sisa kuota di https://aistudio.google.com/rate-limit
GEMINI_API_KEY=
# Model per tahap, boleh daftar dipisah koma (maks. 4). Kuota harian free tier dihitung per model: saat kuota
# model pertama habis, model berikutnya dipakai. Kosongkan untuk memakai bawaan.
# Rubrik (Stage 1) dan saran kelas (Stage 3).
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite,gemini-3.5-flash-lite
# Penilai foto catatan (Stage 2). gemini-3.5-flash-lite lolos uji injeksi live 22 Nov 2026.
GEMINI_VISION_MODEL=gemini-3.5-flash-lite,gemini-2.5-flash-lite
